[Unit]
Description=WeChat Obsidian Assistant Server
After=network.target wehub_llm.service
Wants=wehub_llm.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/wechat_obsidian
ExecStart=/root/mail_assist/venv/bin/python -m server.server
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/root/wechat_obsidian/data/llm-gateway.env
Environment=OMP_NUM_THREADS=1
MemoryMax=500M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
